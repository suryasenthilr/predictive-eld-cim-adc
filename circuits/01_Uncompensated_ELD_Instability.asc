Version 4
SHEET 1 2800 1600
TEXT 100 40 Left 2 ;======================================================================
TEXT 100 70 Left 2 ;CONTINUOUS-TIME DELTA-SIGMA MODULATOR: UNCOMPENSATED ELD INSTABILITY (tau_d = 1.3 Ts)
TEXT 100 100 Left 2 ;Sampling Clock: 1.0 GHz (Ts = 1.0 ns), Excess Loop Delay: 1.3 ns
TEXT 100 130 Left 2 ;======================================================================

* 1. MASTER SAMPLING CLOCK GENERATOR (1 GHz)
TEXT 100 200 Left 2 ;[1. MASTER SAMPLING CLOCK (1 GHz)]
SYMBOL voltage 140 260 R0
WINDOW 123 24 16 Left 2
WINDOW 39 24 56 Left 2
SYMATTR InstName Vclk
SYMATTR Value PULSE(0 1 0 20p 20p 480p 1n)
WIRE 140 240 140 276
FLAG 140 240 clk
WIRE 140 340 140 390
FLAG 140 390 0

* 2. INPUT CURRENT SOURCE (NEURAL ACTIVATION CURRENT)
* bi Pin 1: (x, y+0) = (440, 260), Pin 2: (x, y+80) = (440, 340)
TEXT 400 200 Left 2 ;[2. INPUT NEURAL CURRENT SOURCE]
SYMBOL bi 440 260 R0
WINDOW 123 24 16 Left 2
WINDOW 39 24 56 Left 2
SYMATTR InstName Iin
SYMATTR Value I=25u+10u*sin(2*pi*31.25MEG*time)
WIRE 440 240 440 260
FLAG 440 240 vbl
WIRE 440 340 440 390
FLAG 440 390 0

* 3. FIRST INTEGRATOR: PARASITIC BITLINE CAPACITANCE (C_BL = 100 fF)
* cap Pin 1: (x+16, y+16) = (736, 286), Pin 2: (x+16, y+64) = (736, 334)
TEXT 700 200 Left 2 ;[3. PARASITIC BITLINE CAPACITANCE (INTEGRATOR 1)]
SYMBOL cap 720 270 R0
WINDOW 123 24 16 Left 2
WINDOW 39 24 56 Left 2
SYMATTR InstName Cbl
SYMATTR Value 100f
SYMATTR SpiceLine ic=0.25
WIRE 736 240 736 286
FLAG 736 240 vbl
WIRE 736 334 736 390
FLAG 736 390 0

* res Pin 1: (x+16, y+16) = (856, 286), Pin 2: (x+16, y+96) = (856, 366)
SYMBOL res 840 270 R0
WINDOW 123 24 16 Left 2
WINDOW 39 24 56 Left 2
SYMATTR InstName Rbl
SYMATTR Value 500k
WIRE 856 240 856 286
FLAG 856 240 vbl
WIRE 856 366 856 390
FLAG 856 390 0

* 4. FEEDBACK CURRENT DAC (50 uA, SWITCHED BY DELAYED BITSTREAM y_del)
* bi Pin 1: (x, y+0) = (1100, 260), Pin 2: (x, y+80) = (1100, 340)
TEXT 1050 200 Left 2 ;[4. FEEDBACK CURRENT DAC]
SYMBOL bi 1100 260 R0
WINDOW 123 24 16 Left 2
WINDOW 39 24 56 Left 2
SYMATTR InstName Bidac
SYMATTR Value I=50u*(1/(1+exp(-40*(V(y_del)-0.5))))
WIRE 1100 240 1100 260
FLAG 1100 240 vbl
WIRE 1100 340 1100 390
FLAG 1100 390 0

* 5. SECOND INTEGRATOR: ACTIVE OTA + C2 (400 fF)
* bv Pin 1: (x, y+16) = (1440, 276), Pin 2: (x, y+96) = (1440, 356)
TEXT 1400 200 Left 2 ;[5. SECOND CONTINUOUS INTEGRATOR (OTA + C2)]
SYMBOL bv 1440 260 R0
WINDOW 123 24 16 Left 2
WINDOW 39 24 56 Left 2
SYMATTR InstName Vref_src
SYMATTR Value V=0.25
WIRE 1440 240 1440 276
FLAG 1440 240 ref
WIRE 1440 356 1440 390
FLAG 1440 390 0

* Gota bi Pin 1: (x, y+0) = (1640, 260), Pin 2: (x, y+80) = (1640, 340)
SYMBOL bi 1640 260 R0
WINDOW 123 24 16 Left 2
WINDOW 39 24 56 Left 2
SYMATTR InstName Gota
SYMATTR Value I=100u*(V(vbl)-V(ref))
WIRE 1640 240 1640 260
FLAG 1640 240 v2
WIRE 1640 340 1640 390
FLAG 1640 390 0

SYMBOL cap 1800 270 R0
WINDOW 123 24 16 Left 2
WINDOW 39 24 56 Left 2
SYMATTR InstName C2
SYMATTR Value 400f
SYMATTR SpiceLine ic=0
WIRE 1816 240 1816 286
FLAG 1816 240 v2
WIRE 1816 334 1816 390
FLAG 1816 390 0

SYMBOL res 1920 270 R0
WINDOW 123 24 16 Left 2
WINDOW 39 24 56 Left 2
SYMATTR InstName Rleak2
SYMATTR Value 10MEG
WIRE 1936 240 1936 286
FLAG 1936 240 v2
WIRE 1936 366 1936 390
FLAG 1936 390 0

* 6. UNCOMPENSATED SUMMING NODE & COMPARATOR
* bv Pin 1: (x, y+16) = (180, 636), Pin 2: (x, y+96) = (180, 716)
TEXT 100 550 Left 2 ;[6. QUANTIZER SUMMING JUNCTION & DYNAMIC COMPARATOR]
SYMBOL bv 180 620 R0
WINDOW 123 24 16 Left 2
WINDOW 39 24 56 Left 2
SYMATTR InstName Bvq
SYMATTR Value V=1.864*(V(vbl)-0.25)+1.520*V(v2)
WIRE 180 600 180 636
FLAG 180 600 vq
WIRE 180 716 180 750
FLAG 180 750 0

SYMBOL bv 440 620 R0
WINDOW 123 24 16 Left 2
WINDOW 39 24 56 Left 2
SYMATTR InstName Byout
SYMATTR Value V=(V(vq)>0)
WIRE 440 600 440 636
FLAG 440 600 y_out
WIRE 440 716 440 750
FLAG 440 750 0

* 7. EXCESS LOOP DELAY (T-LINE: tau_d = 1.3 ns)
TEXT 750 550 Left 2 ;[7. EXCESS LOOP DELAY BLOCK (tau_d = 1.3 ns)]
SYMBOL tline 860 620 R0
WINDOW 123 24 16 Left 2
WINDOW 39 24 56 Left 2
SYMATTR InstName Teld
SYMATTR Value Td=1.3n Z0=1k
WIRE 812 604 770 604
FLAG 770 604 y_out
WIRE 812 636 770 636
FLAG 770 636 0
WIRE 908 604 960 604
FLAG 960 604 y_del
WIRE 908 636 960 636
FLAG 960 636 0

SYMBOL res 1040 590 R0
WINDOW 123 24 16 Left 2
WINDOW 39 24 56 Left 2
SYMATTR InstName Rterm3
SYMATTR Value 1k
WIRE 1056 570 1056 606
FLAG 1056 570 y_del
WIRE 1056 686 1056 730
FLAG 1056 730 0

* SIMULATION COMMANDS
TEXT 100 900 Left 2 !.tran 0 50n 0 5p uic
TEXT 100 940 Left 2 !.options method=gear plotwinsize=0
